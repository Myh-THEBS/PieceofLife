<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 读取外部存储权限（Android 13+ 使用 READ_MEDIA_IMAGES） -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".PieceOfLifeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/newlogo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiecesOfLife"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AddonToolActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AppSettingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.UserSettingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ItemEditActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LogQueryActivity"
            android:exported="false" />

        <activity
            android:name=".ui.QuestSettingActivity"
            android:exported="false" />

    </application>

</manifest>
