<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <RelativeLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/toolbarBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/empty_string" />

        <ImageView
            android:id="@+id/btnReturn"
            android:contentDescription="@string/addon_return"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="6dp"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="28dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCancel"
            android:contentDescription="@string/addon_cancel"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/bottomSpacer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.0"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/btnConfirm"
            android:contentDescription="@string/addon_confirm"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/contentBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topToolbar"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="74dp"
        android:scrollbars="none"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- 属性名称 -->
            <LinearLayout
                android:id="@+id/rowName"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconName"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_name" />

                <TextView
                    android:id="@+id/labelName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_name"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:maxLength="10"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 属性简写 -->
            <LinearLayout
                android:id="@+id/rowAbbr"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconAbbr"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_abbr" />

                <TextView
                    android:id="@+id/labelAbbr"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_abbr"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etAbbr"
                    android:layout_width="150dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:maxLength="5"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 属性图标 -->
            <LinearLayout
                android:id="@+id/rowIcon"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconEmoji"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_icon" />

                <TextView
                    android:id="@+id/labelIcon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_icon"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etIcon"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:maxLength="10"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 属性值/技能经验 -->
            <LinearLayout
                android:id="@+id/rowValue"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconValue"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_value" />

                <TextView
                    android:id="@+id/labelValue"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_value"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etValue"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 升级所需经验 -->
            <LinearLayout
                android:id="@+id/rowLevelExp"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconLevelExp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_level_exp" />

                <TextView
                    android:id="@+id/labelLevelExp"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_level_exp"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etLevelExp"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 优先级 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/click_background">

                <ImageView
                    android:id="@+id/iconPriority"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/item_field_priority" />

                <TextView
                    android:id="@+id/labelPriority"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingBottom="4dp"
                    android:text="@string/item_field_priority"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <EditText
                    android:id="@+id/etPriority"
                    android:layout_width="100dp"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="10dp"
                    android:layout_margin="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="end|center_vertical"
                    android:inputType="number"
                    android:textColor="@color/TEXT_black"
                    android:textSize="20dp" />
            </LinearLayout>

            <!-- 属性描述/短语内容 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconRule"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/item_field_rule" />

                    <TextView
                        android:id="@+id/labelRule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:paddingBottom="4dp"
                        android:text="@string/item_field_rule"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/wqy_12px"
                        android:textSize="26dp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etRule"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/background_input"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:maxLength="300"
                    android:padding="8dp"
                    android:textColor="@color/TEXT_black"
                    android:textSize="16dp" />
            </LinearLayout>

            <!-- 删除按钮 -->
            <LinearLayout
                android:id="@+id/rowDelete"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/labelDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:fontFamily="@font/wqy_12px"
                    android:paddingBottom="4dp"
                    android:text="@string/item_delete"
                    android:textColor="#D24C4C"
                    android:textSize="20dp" />

                <ImageView
                    android:id="@+id/btnDelete"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/item_delete" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
