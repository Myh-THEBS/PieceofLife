<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <!-- 顶层工具栏 -->
    <RelativeLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/toolbarBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/empty_string" />

        <ImageView
            android:id="@+id/btnReturn"
            android:contentDescription="@string/addon_return"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="6dp"
            android:text="@string/addon_title"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="28dp">
        </TextView>

    </RelativeLayout>

    <!-- 底部确定和取消 -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCancel"
            android:contentDescription="@string/addon_cancel"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true">
        </ImageView>

        <ImageView
            android:id="@+id/bottomSpacer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.0"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/btnConfirm"
            android:contentDescription="@string/addon_confirm"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true">
        </ImageView>

    </LinearLayout>

    <!-- 主体背景层（夹在工具栏和底部栏之间） -->
    <ImageView
        android:id="@+id/contentBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topToolbar"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <!-- 主体内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="74dp"
        android:scrollbars="none"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="top">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="30dp">

            <GridLayout
                android:id="@+id/functionGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:useDefaultMargins="true">

                <!-- 工具 1 -->
                <LinearLayout
                    android:id="@+id/toolPanel1"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool1">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool1"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 2 -->
                <LinearLayout
                    android:id="@+id/toolPanel2"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool2">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool2"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 3 -->
                <LinearLayout
                    android:id="@+id/toolPanel3"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool3">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool3"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 4 -->
                <LinearLayout
                    android:id="@+id/toolPanel4"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon4"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool4">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool4"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 5 -->
                <LinearLayout
                    android:id="@+id/toolPanel5"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon5"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool5">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool5"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 6 -->
                <LinearLayout
                    android:id="@+id/toolPanel6"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon6"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool6">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool6"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

                <!-- 工具 7 -->
                <LinearLayout
                    android:id="@+id/toolPanel7"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_columnWeight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/toolIcon7"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/addon_tool7">

                    </ImageView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addon_tool7"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/silver"
                        android:textSize="24dp"
                        android:textStyle="bold">
                    </TextView>
                </LinearLayout>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
