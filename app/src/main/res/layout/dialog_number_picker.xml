<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/titleContainer"
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/dialogIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:contentDescription="@string/empty_string" />

        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/dialogIcon"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="24dp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 范围整数模式 -->
    <LinearLayout
        android:id="@+id/rangeIntContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="24dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnMinusRange"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/empty_string" />

        <TextView
            android:id="@+id/tvRangeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:gravity="center"
            android:minWidth="80dp"
            android:paddingVertical="8dp"
            android:background="@drawable/background_input"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="28dp"
            android:text="0" />

        <ImageView
            android:id="@+id/btnPlusRange"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/empty_string" />
    </LinearLayout>

    <!-- 时间输入模式 -->
    <LinearLayout
        android:id="@+id/timeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="20dp"
        android:visibility="gone">

        <!-- 小时列 -->
        <LinearLayout
            android:id="@+id/hourColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnHourPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/empty_string" />

            <TextView
                android:id="@+id/tvHourValue"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:background="@drawable/background_input"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="28dp"
                android:text="00" />

            <ImageView
                android:id="@+id/btnHourMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/empty_string" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/time_unit_hour"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="26dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 分隔符 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:text=":"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="32dp"
            android:paddingBottom="48dp" />

        <!-- 分钟列 -->
        <LinearLayout
            android:id="@+id/minuteColumn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/btnMinPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/empty_string" />

            <TextView
                android:id="@+id/tvMinValue"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:background="@drawable/background_input"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="28dp"
                android:text="00" />

            <ImageView
                android:id="@+id/btnMinMinus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/empty_string" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/time_unit_minute"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="26dp"
                android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/btnCancel"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/addon_cancel" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnConfirm"
            android:layout_width="96dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/addon_confirm" />
    </LinearLayout>
</LinearLayout>
