<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/toolbarBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/empty_string" />

        <ImageView
            android:id="@+id/btnReturn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/click_background"
            android:contentDescription="@string/addon_return" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="6dp"
            android:text="@string/log_info_title"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="28dp" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/contentBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/topToolbar"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="70dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="top">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/log_info_title"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="26dp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="120dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/background_input"
                android:padding="12dp"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/wqy_12px"
                android:textSize="20sp"
                android:gravity="start|top"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:id="@+id/questReversalRow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/log_info_quest_reversal"
                    android:textStyle="bold"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnReversal"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/click_background"
                    android:contentDescription="@string/log_info_quest_reversal" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/fileManagementSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/log_info_file_management"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/log_info_rename"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/wqy_12px"
                        android:textSize="26dp" />

                    <ImageView
                        android:id="@+id/btnRename"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/log_info_rename" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/log_info_reupload"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/wqy_12px"
                        android:textSize="26dp" />

                    <ImageView
                        android:id="@+id/btnReupload"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/log_info_reupload" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/log_info_export"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/wqy_12px"
                        android:textSize="26dp" />

                    <ImageView
                        android:id="@+id/btnExport"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/click_background"
                        android:contentDescription="@string/log_info_export" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
