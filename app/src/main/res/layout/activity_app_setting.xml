<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <RelativeLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp">

        <ImageView
            android:id="@+id/toolbarBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/empty_string" />

        <ImageView
            android:id="@+id/btnReturn"
            android:contentDescription="@string/addon_return"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:paddingBottom="6dp"
            android:text="@string/app_setting_title"
            android:textColor="@color/TEXT_black"
            android:fontFamily="@font/wqy_12px"
            android:textSize="28dp" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCancel"
            android:contentDescription="@string/addon_cancel"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true" />

        <ImageView
            android:id="@+id/bottomSpacer"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1.0"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/btnConfirm"
            android:contentDescription="@string/addon_confirm"
            android:layout_width="144dp"
            android:layout_height="64dp"
            android:scaleType="fitXY"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ImageView
        android:id="@+id/contentBg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topToolbar"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="64dp"
        android:scrollbars="none"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:gravity="top">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <!-- 0. 用户设置 -->
            <LinearLayout
                android:id="@+id/rowUserSetting"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/click_background">

                <ImageView
                    android:id="@+id/iconUserSetting"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_user" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/app_setting_user"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnUserSetting"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_user_enter" />
            </LinearLayout>

            <!-- 1. 调试模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"

                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconDebug"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_debug" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/app_setting_debug"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnDebugToggle"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_debug_on" />
            </LinearLayout>

            <!-- 2. 左手主键 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconLeftMode"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_left" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/app_setting_left"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnLeftToggle"
                    android:layout_width="96dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_left_on" />
            </LinearLayout>

            <!-- 3. 显示模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconDisplay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_display" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/app_setting_display"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnDisplayMonth"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_month" />

                <ImageView
                    android:id="@+id/btnDisplayWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_week" />

                <ImageView
                    android:id="@+id/btnDisplayDay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_day" />
            </LinearLayout>

            <!-- 4. 数据备份 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iconBackup"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/app_setting_backup" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:paddingBottom="4dp"
                    android:text="@string/app_setting_backup"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:textSize="26dp" />

                <ImageView
                    android:id="@+id/btnBackupSave"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_save" />

                <ImageView
                    android:id="@+id/btnBackupLoad"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/app_setting_load" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
