<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/main_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Pieces of Life"
        android:textColor="@color/TEXT_white1"
        android:textSize="20sp" />

    <ImageView
        android:id="@+id/btnAddonTool"
        android:layout_width="240dp"
        android:layout_height="32dp"
        android:layout_marginTop="40dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="附加工具" />

    <!-- PixelDialog 测试按钮 -->
    <ImageView
        android:id="@+id/btnDialogInfo"
        android:layout_width="240dp"
        android:layout_height="32dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="信息弹窗测试" />

    <ImageView
        android:id="@+id/btnDialogWarn"
        android:layout_width="240dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="警告弹窗测试" />

    <ImageView
        android:id="@+id/btnDialogError"
        android:layout_width="240dp"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="错误弹窗测试" />

    <ImageView
        android:id="@+id/btnAppSetting"
        android:layout_width="360dp"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="APP设置" />

</LinearLayout>
