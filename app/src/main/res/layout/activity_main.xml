<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <ImageView
        android:id="@+id/toolbarBg"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:padding="10dp"
        android:orientation="horizontal"
        android:layout_alignParentTop="true">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/background_input"
            android:contentDescription="@string/empty_string" />

        <LinearLayout
            android:id="@+id/rightContainer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="80dp"
            android:layout_marginStart="4dp"

            android:orientation="vertical">

            <!-- 第一行：等级 + 经验条 -->
            <LinearLayout
                android:id="@+id/rowLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="建学"
                    android:textColor="@color/TEXT_black"
                    android:fontFamily="@font/wqy_12px"
                    android:layout_marginStart="5dp"
                    android:textStyle="bold"
                    android:textSize="28dp" />

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="2dp"
                    android:gravity="bottom"
                    android:textColor="@color/TEXT_black"
                    android:layout_gravity="center"
                    android:text="Lv. 99+"
                    android:paddingHorizontal="8dp"
                    android:background="@drawable/background_input"
                    android:fontFamily="@font/fonsung"
                    android:textStyle="bold"
                    android:textSize="18dp" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
            </Space>


            <!-- 第二行：数值属性 -->
            <LinearLayout
                android:id="@+id/attrContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/attrItem1"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="0.3"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_input"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvAttrIcon1"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="22dp"
                        android:maxWidth="50dp"
                        android:textSize="16dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung"/>

                    <TextView
                        android:id="@+id/tvAttrValue1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/attrItem2"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="0.3"
                    android:gravity="center_vertical"
                    android:background="@drawable/background_input"
                    android:orientation="horizontal"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvAttrIcon2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="22dp"
                        android:maxWidth="50dp"
                        android:textSize="16dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung"/>

                    <TextView
                        android:id="@+id/tvAttrValue2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/attrItem3"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="0.3"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/background_input"
                    android:paddingHorizontal="8dp">

                    <TextView
                        android:id="@+id/tvAttrIcon3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:minWidth="22dp"
                        android:maxWidth="50dp"
                        android:textSize="16dp"
                        android:gravity="center"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung"/>

                    <TextView
                        android:id="@+id/tvAttrValue3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/TEXT_black"
                        android:fontFamily="@font/fonsung" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView（日志列表） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomBar"
        android:clipToPadding="false"
        android:paddingBottom="200dp" />

    <!-- 加载覆盖层（预留） -->
    <RelativeLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomBar"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/main_background">

        <ImageView
            android:id="@+id/ivLoading"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:contentDescription="@string/empty_string" />
    </RelativeLayout>

    <!-- 浮动主键（FAB） -->
    <ImageView
        android:id="@+id/btnNewLog"
        android:layout_width="144dp"
        android:layout_height="144dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="116dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/main_new_log" />

    <ImageView
        android:id="@+id/bottomBarBg"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:scaleType="fitXY"
        android:contentDescription="@string/empty_string" />

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:paddingTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnTool1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/toolIcon1"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/click_background"
                android:duplicateParentState="true"
                android:contentDescription="@string/main_today" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_today"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/silver"
                android:textSize="20dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTool2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/toolIcon2"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/click_background"
                android:duplicateParentState="true"
                android:contentDescription="@string/main_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_search"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/silver"
                android:textSize="20dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTool3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/toolIcon3"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/click_background"
                android:duplicateParentState="true"
                android:contentDescription="@string/main_toolbox" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_toolbox"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/silver"
                android:textSize="20dp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnTool4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/toolIcon4"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/click_background"
                android:duplicateParentState="true"
                android:contentDescription="@string/main_settings" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_settings"
                android:textColor="@color/TEXT_black"
                android:fontFamily="@font/silver"
                android:textSize="20dp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
