<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局属性定义 -->
    <attr name="pixelScale" format="integer" />

    <declare-styleable name="PixelImageView">
        <attr name="spriteName" format="string" />
        <attr name="pixelScale" />
        <attr name="ninePatch" format="boolean" />
        <attr name="backgroundMode" format="enum">
            <enum name="tile" value="0" />
            <enum name="stretch" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="PixelImageButton">
        <attr name="spriteUp" format="string" />
        <attr name="spriteDown" format="string" />
        <attr name="pixelScale" />
        <attr name="defaultPressed" format="boolean" />
    </declare-styleable>
</resources>
